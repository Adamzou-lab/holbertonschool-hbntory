# Provider LLM (choisir sans modifier le code)
# Providers supportes par PydanticAI : anthropic, openai, google (Gemini), ollama, ...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest

# Cles API (variables standard, utilisateur met la sienne)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Connexion au serveur MCP HBntory (Bloc 2, deja livre)
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_TRANSPORT=streamable-http

# Serveur IA
AI_HOST=0.0.0.0
AI_PORT=8080
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30