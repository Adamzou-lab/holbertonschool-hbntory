# Copier en .env avant `docker compose up`. Les valeurs par défaut dans
# docker-compose.yml suffisent pour un simple test en local, mais gardent
# le même secret partagé que product_mcp_server/.env.example — à changer
# si vous voulez tester avec des identifiants différents.

SECRET_KEY=dev-secret-change-me
BACKOFFICE_INTERNAL_TOKEN=change-me-shared-secret
ADMIN_EMAIL=admin@zaiko.local
ADMIN_PASSWORD=changeme123

# Service IA (agent réel, cf. ai_service/README.md) — une seule clé
# nécessaire selon LLM_PROVIDER, les autres peuvent rester vides.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
